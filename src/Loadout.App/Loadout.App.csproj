<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Loadout.App</RootNamespace>
    <!-- Not Loadout.exe: Windows takes that name for a game, and without Game Bar shows an error at each start. -->
    <AssemblyName>LoadoutPS2</AssemblyName>
    <ApplicationTitle>Loadout for PS2</ApplicationTitle>
    <!-- The file description: Windows names the app by it in notifications and in Task Manager. -->
    <AssemblyTitle>Loadout for PS2</AssemblyTitle>
    <Product>Loadout for PS2</Product>
    <!-- The mark, rendered by ps2/tools/make_icon.py. -->
    <ApplicationIcon>Assets\loadout.ico</ApplicationIcon>
    <!-- Not marked CET compatible: on a Windows 10 without its updates and a processor with CET (Intel 11th generation,
         AMD Zen 3 and later), .NET stops a marked program at start because that Windows doesn't fully support CET. -->
    <CETCompat>false</CETCompat>
    <!-- For Windows notifications only: a notification-area icon's balloon (Windows Forms' NotifyIcon), which Windows 10
         and 11 show as a notification. Windows Forms comes with the same desktop runtime as WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows Forms' names stay out of the WPF code: DesktopNotifier names them in full. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Windows 10 and 11 include SQLite as winsqlite3.dll, so the app does not ship its own. -->
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Barlow: one copy of the Bay's files, plus Medium, the desktop's body weight. -->
    <Resource Include="..\..\ps2\assets\fonts\*.ttf" LinkBase="Assets\Fonts" />
    <Resource Include="Assets\Fonts\Barlow-Medium.ttf" />
    <Resource Include="Assets\loadout.ico" />
    <None Include="..\..\ps2\third_party\barlow\OFL.txt" Link="ThirdParty\Barlow-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loadout.Core\Loadout.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shown on the About page; the zip has the same files next to the executable. -->
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <!-- The Loadout Bay of this version, offered to a PS2 that runs another. Built in ps2/; without it nothing is offered.
       It is embedded gzipped, and MainWindow.BundledBay unpacks it: the exe is about 2 MB smaller, and signed with the
       ELF as it is, 0.11.0 and 0.11.1 were taken for malware by Bitdefender's engine (Gen:Variant.Yogi), which a
       signed build with the ELF gzipped is not (VirusTotal, 2026-11-20). -->
  <PropertyGroup>
    <LoadoutBayElf>$(MSBuildThisFileDirectory)..\..\ps2\loadout-bay.elf</LoadoutBayElf>
  </PropertyGroup>

  <UsingTask TaskName="GzipLoadoutBay" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(Destination)));
        using (var input = File.OpenRead(Source))
        using (var output = File.Create(Destination))
        using (var gzip = new GZipStream(output, CompressionLevel.Optimal))
        {
            input.CopyTo(gzip);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="CompressLoadoutBay" Condition="Exists('$(LoadoutBayElf)')" Inputs="$(LoadoutBayElf)" Outputs="$(IntermediateOutputPath)loadout-bay.elf.gz">
    <GzipLoadoutBay Source="$(LoadoutBayElf)" Destination="$(IntermediateOutputPath)loadout-bay.elf.gz" />
  </Target>

  <!-- Before the build, not before PrepareResourceNames: that one's dependencies would have named the resources already. -->
  <Target Name="EmbedLoadoutBay" BeforeTargets="BeforeBuild" DependsOnTargets="CompressLoadoutBay" Condition="Exists('$(LoadoutBayElf)')">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)loadout-bay.elf.gz" LogicalName="loadout-bay.elf.gz" />
      <FileWrites Include="$(IntermediateOutputPath)loadout-bay.elf.gz" />
    </ItemGroup>
  </Target>

</Project>
