<local:LoadoutWindow x:Class="Loadout.App.QuestionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Loadout.App"
        xmlns:core="clr-namespace:Loadout.Core;assembly=Loadout.Core"
        Title="{x:Static core:ProductInfo.Name}"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppSurfaceRaised}">
    <!-- Tab cycles through the item list and the buttons. -->
    <DockPanel KeyboardNavigation.TabNavigation="Cycle">
        <Border DockPanel.Dock="Bottom" Height="64" Padding="24,0" Background="{DynamicResource AppBackground}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ConfirmButton" Click="Confirm_OnClick" />
                <Button x:Name="CancelButton" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </Border>
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- 28 px, its middle on the title's first line (24 high). -->
            <Path x:Name="KindIcon"
                  Width="28"
                  Height="28"
                  Margin="0,-2,16,0"
                  VerticalAlignment="Top"
                  Visibility="Collapsed" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.DialogTitle}" TextWrapping="Wrap" />
                <TextBlock x:Name="BodyText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource AppMuted}" />
                <Border x:Name="ItemBox"
                        Margin="0,16,0,0"
                        Background="{DynamicResource AppSurface}"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <ScrollViewer x:Name="ItemScroller"
                                  MaxHeight="192"
                                  Focusable="True"
                                  IsTabStop="True"
                                  FocusVisualStyle="{StaticResource FocusRing}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="Items">
                        <ItemsControl x:Name="ItemList" Focusable="False" Padding="0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="12,4" Style="{StaticResource Text.Cell}" Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <!-- A question with ChooseItem: one of the items, the first selected. -->
                <ListBox x:Name="ChoiceList"
                         Margin="0,16,0,0"
                         MaxHeight="192"
                         SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource ChoiceItemStyle}"
                         AutomationProperties.Name="Choices"
                         Visibility="Collapsed">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Text.Cell}" Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Grid>
    </DockPanel>
</local:LoadoutWindow>
