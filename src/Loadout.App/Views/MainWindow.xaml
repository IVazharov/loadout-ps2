<local:LoadoutWindow x:Class="Loadout.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Loadout.App"
        xmlns:c="clr-namespace:Loadout.App.Controls"
        xmlns:core="clr-namespace:Loadout.Core;assembly=Loadout.Core"
        Title="{x:Static core:ProductInfo.Name}"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Height="900"
        Width="1180"
        MinHeight="640"
        MinWidth="960">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <c:CollapsedWhenTrueConverter x:Key="CollapsedWhenTrue" />
        <local:ArtworkPreviewConverter x:Key="ArtworkPreviewConverter" />
        <!-- The page header's summary sits on the title's baseline. -->
        <Style x:Key="PageSummary" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
            <Setter Property="Foreground" Value="{DynamicResource AppLabel}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="16,0,0,4" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <!-- Command bar, 12 px under the header: secondaries from the left, the primary at the right. -->
        <Style x:Key="CommandBar" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="LastChildFill" Value="False" />
        </Style>
        <Style x:Key="EmptyHeadline" TargetType="TextBlock" BasedOn="{StaticResource Text.Headline}">
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="EmptyDetail" TargetType="TextBlock" BasedOn="{StaticResource Text.Detail}">
            <Setter Property="Foreground" Value="{DynamicResource AppMuted}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,16" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="Foreground" Value="{DynamicResource AppMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <c:EnumMatchConverter x:Key="EnumMatch" />
        <!-- Settings: a section heading with its divider and the quiet "Saved" or the error at the right;
             44 px rows with a 180 px label column; help and notes under the control, in the control column. -->
        <DataTemplate x:Key="SettingsHeading" DataType="{x:Type local:SettingsSection}">
            <Border Margin="0,16,0,0" Padding="0,0,0,6" BorderBrush="{DynamicResource AppDivider}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Saved, Converter={StaticResource VisibleWhenTrue}}">
                            <Path Width="12" Height="12" VerticalAlignment="Center" Stretch="Uniform"
                                  Stroke="{DynamicResource AppOk}" StrokeThickness="2" Data="M1,6 L4.5,9.5 L11,2.5" />
                            <TextBlock Margin="4,0,0,0" Style="{StaticResource Text.Detail}" Foreground="{DynamicResource AppOk}" Text="Saved" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Detail}"
                                   Foreground="{DynamicResource AppError}"
                                   Text="{Binding Error}"
                                   Visibility="{Binding HasError, Converter={StaticResource VisibleWhenTrue}}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Label}"
                               Foreground="{DynamicResource AppLabel}"
                               Text="{Binding Title, Converter={StaticResource UpperCase}}"
                               AutomationProperties.Name="{Binding Title}"
                               AutomationProperties.HeadingLevel="Level2" />
                </DockPanel>
            </Border>
        </DataTemplate>
        <Style x:Key="SettingsRow" TargetType="Grid">
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style x:Key="BayPickerItem" TargetType="ListBoxItem" BasedOn="{StaticResource ChoiceItemStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
        <Style x:Key="SettingsNote" TargetType="TextBlock" BasedOn="{StaticResource Text.Detail}">
            <Setter Property="Margin" Value="180,-4,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource AppMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- The details panel's help line: AppMuted, or AppError when it says what went wrong. -->
        <Style x:Key="DetailsHelp" TargetType="TextBlock" BasedOn="{StaticResource Text.Detail}">
            <Setter Property="Foreground" Value="{DynamicResource AppMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <!-- Two lines at most, so the details panel keeps its height. The tooltip has all of a longer message. -->
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxHeight" Value="36" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DetailsHelpIsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AppError}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DetailsHelp}" Value="">
                    <Setter Property="ToolTip" Value="{x:Null}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate DataType="{x:Type local:InstalledGamesViewModel}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="INSTALLED GAMES" AutomationProperties.Name="Installed Games" />
                    <TextBlock Style="{StaticResource PageSummary}" Text="{Binding Summary}" />
                </Grid>
                <DockPanel DockPanel.Dock="Top" Style="{StaticResource CommandBar}">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButton}"
                            Content="{Binding ConnectLabel}"
                            ToolTip="Reads the game list from Loadout Bay at the address in Settings."
                            IsEnabled="{Binding CanConnect}"
                            Command="{Binding ConnectCommand}" />
                    <Button DockPanel.Dock="Right"
                            Margin="0,0,8,0"
                            Content="Cancel"
                            ToolTip="Stops the search for Loadout Bay on the network."
                            Command="{Binding CancelSearchCommand}"
                            Visibility="{Binding IsSearching, Converter={StaticResource VisibleWhenTrue}}" />
                    <Button Content="_Remove…"
                            ToolTip="Deletes the selected games, whole or incomplete, from the PS2's hard disk."
                            IsEnabled="{Binding CanRemove}"
                            Command="{Binding RemoveCommand}" />
                    <Button Margin="8,0,0,0"
                            Content="_Give memory cards…"
                            ToolTip="Gives each selected game without a memory card, or with a missing one, a new card in OPL's VMC folder, set in slot 1 of its OPL settings. Cards already on the PS2 are kept, with their saves."
                            IsEnabled="{Binding CanGiveCards}"
                            Command="{Binding GiveCardsCommand}" />
                    <Button Margin="16,0,0,0"
                            Content="Put Loadout Bay on the hard disk…"
                            ToolTip="Copies this Loadout's Loadout Bay into APPS/Loadout-Bay, so OPL's Apps menu starts it without the USB drive."
                            IsEnabled="{Binding CanConnect}"
                            Command="{Binding PutBayOnDiskCommand}" />
                </DockPanel>
                <c:StatusPanel DockPanel.Dock="Top" Margin="0,12,0,0" Status="{Binding Status}" />
                <!-- 176 px whatever it shows, so the table above never moves. -->
                <Border DockPanel.Dock="Bottom"
                        Height="176"
                        Margin="0,12,0,0"
                        Padding="16,14"
                        Background="{DynamicResource AppSurface}"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1"
                        Visibility="{Binding HasGames, Converter={StaticResource VisibleWhenTrue}}">
                    <Grid>
                        <DockPanel Visibility="{Binding CanEdit, Converter={StaticResource VisibleWhenTrue}}">
                            <StackPanel DockPanel.Dock="Top" Height="20" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource Text.Label}"
                                           Foreground="{DynamicResource AppLabel}"
                                           Text="GAME DETAILS"
                                           AutomationProperties.Name="Game details"
                                           AutomationProperties.HeadingLevel="Level2" />
                                <c:InfoTip Margin="8,0,0,0"
                                           AutomationProperties.Name="More about game details"
                                           ToolTip="The title and disc type are in the game's header; the modes and transfer mode are in its OPL settings file, as OPL's own game settings save them. Save changes writes only what you changed. The partition name keeps the old title." />
                                <TextBlock Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Text.Detail}"
                                           Foreground="{DynamicResource AppMuted}"
                                           Typography.NumeralAlignment="Tabular"
                                           Text="{Binding SelectedGame.DiscId}" />
                            </StackPanel>
                            <DockPanel DockPanel.Dock="Bottom" Height="36">
                                <Button DockPanel.Dock="Right"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="_Save changes"
                                        IsEnabled="{Binding CanSave}"
                                        Command="{Binding SaveEditCommand}" />
                                <Button DockPanel.Dock="Right"
                                        Content="Re_vert"
                                        ToolTip="Puts back the values read from the PS2."
                                        IsEnabled="{Binding IsDirty}"
                                        Command="{Binding RevertCommand}" />
                                <DockPanel Margin="0,0,12,0">
                                    <Control DockPanel.Dock="Left"
                                             Width="16"
                                             Height="16"
                                             Margin="0,0,8,0"
                                             Style="{StaticResource Spinner}"
                                             Visibility="{Binding IsReadingSettings, Converter={StaticResource VisibleWhenTrue}}" />
                                    <TextBlock Style="{StaticResource DetailsHelp}" Text="{Binding DetailsHelp}" />
                                </DockPanel>
                            </DockPanel>
                            <Grid Margin="0,6,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Title" />
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="TitleBox"
                                             MaxLength="80"
                                             VerticalAlignment="Center"
                                             AutomationProperties.Name="Title"
                                             Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Margin="9,0,0,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Style="{StaticResource Text.Detail}"
                                               Foreground="{DynamicResource AppDisabled}"
                                               Text="Title can't be empty"
                                               Visibility="{Binding TitleIsBlank, Converter={StaticResource VisibleWhenTrue}}" />
                                </Grid>
                                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Disc type" />
                                <ComboBox Grid.Row="2"
                                          Grid.Column="1"
                                          Width="160"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.Name="Disc type"
                                          ItemsSource="{Binding DiscTypeChoices}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding EditorDiscType}" />
                                <TextBlock Grid.Column="3" Style="{StaticResource FieldLabel}" Text="Modes" />
                                <ItemsControl Grid.Column="4"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              IsEnabled="{Binding CanEditSettings}"
                                              AutomationProperties.Name="Modes"
                                              ItemsSource="{Binding CompatibilityModes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Margin="0,0,12,0"
                                                      Content="{Binding Label}"
                                                      ToolTip="{Binding Name}"
                                                      AutomationProperties.Name="{Binding Name}"
                                                      IsChecked="{Binding IsSet}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource FieldLabel}" Text="Transfer" />
                                <ComboBox Grid.Row="2"
                                          Grid.Column="4"
                                          Width="160"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.Name="Transfer"
                                          IsEnabled="{Binding CanEditSettings}"
                                          ItemsSource="{Binding DmaChoices}"
                                          SelectedIndex="{Binding EditorDma}" />
                            </Grid>
                        </DockPanel>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource Text.Detail}"
                                   Foreground="{DynamicResource AppMuted}"
                                   Text="{Binding EditorHint}"
                                   Visibility="{Binding CanEdit, Converter={StaticResource CollapsedWhenTrue}}" />
                    </Grid>
                </Border>
                <Grid Margin="0,12,0,0">
                    <local:InstalledGamesListPanel Visibility="{Binding HasGames, Converter={StaticResource VisibleWhenTrue}}" />
                    <c:ChamferBorder Style="{StaticResource EmptyState}" Visibility="{Binding HasGames, Converter={StaticResource CollapsedWhenTrue}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                            <TextBlock Style="{StaticResource EmptyHeadline}" Text="{Binding EmptyHeadline}" />
                            <TextBlock Style="{StaticResource EmptyDetail}" Text="{Binding EmptyDetail}" />
                            <Button HorizontalAlignment="Center"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Go to Install"
                                    Command="{Binding DataContext.ShowInstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Visibility="{Binding NoGamesOnPs2, Converter={StaticResource VisibleWhenTrue}}" />
                            <StackPanel HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Visibility="{Binding NoGamesOnPs2, Converter={StaticResource CollapsedWhenTrue}}">
                                <Button Style="{StaticResource PrimaryButton}"
                                        Content="Connect"
                                        IsEnabled="{Binding CanConnect}"
                                        Command="{Binding ConnectCommand}" />
                                <Button Margin="8,0,0,0"
                                        IsEnabled="{Binding CanFind}"
                                        Command="{Binding FindBayCommand}"
                                        AutomationProperties.Name="Find Bay"
                                        AutomationProperties.ItemStatus="{Binding FindStatus}"
                                        ToolTip="Looks for Loadout Bay on this PC's networks and sets its address in Settings.">
                                    <StackPanel Orientation="Horizontal">
                                        <Control Width="16"
                                                 Height="16"
                                                 Margin="0,0,8,0"
                                                 Style="{StaticResource Spinner}"
                                                 Visibility="{Binding IsFinding, Converter={StaticResource VisibleWhenTrue}}" />
                                        <AccessText VerticalAlignment="Center" Text="{Binding FindLabel}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </c:ChamferBorder>
                </Grid>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:InstallViewModel}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="INSTALL" AutomationProperties.Name="Install" />
                    <TextBlock Style="{StaticResource PageSummary}" Text="{Binding Summary}" />
                </Grid>
                <DockPanel DockPanel.Dock="Top" Style="{StaticResource CommandBar}">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButton}"
                            Content="_Install on PS2"
                            ToolTip="Installs every Ready game in the queue through Loadout Bay at the address in Settings."
                            IsEnabled="{Binding CanInstall}"
                            Command="{Binding InstallCommand}" />
                    <Button DockPanel.Dock="Right"
                            Margin="0,0,8,0"
                            Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsWorking, Converter={StaticResource VisibleWhenTrue}}" />
                    <Button Content="Add _files…"
                            ToolTip="Adds disc images: iso, bin, cue or chd."
                            Command="{Binding AddFilesCommand}" />
                    <Button Margin="8,0,0,0"
                            Content="Add f_older…"
                            ToolTip="Adds the disc images in one folder: iso, bin, cue or chd."
                            Command="{Binding AddFolderCommand}" />
                    <Button Margin="8,0,0,0"
                            Content="Add folder and _subfolders…"
                            ToolTip="Adds the disc images in a folder and every folder inside it: iso, bin, cue or chd."
                            Command="{Binding AddFolderRecursiveCommand}" />
                    <Button Margin="8,0,0,0"
                            Content="Back up a _disc…"
                            ToolTip="Opens Back up discs, which copies a PS2 disc in a drive on this PC to an image here."
                            Command="{Binding DataContext.ShowBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Margin="16,0,0,0"
                            Content="_Remove"
                            ToolTip="Takes the selected games out of the queue. Nothing is deleted on the PS2."
                            IsEnabled="{Binding HasSelection}"
                            Command="{Binding RemoveCommand}" />
                </DockPanel>
                <StackPanel DockPanel.Dock="Top" Height="32" Margin="0,8,0,0" Orientation="Horizontal">
                    <CheckBox VerticalAlignment="Center"
                              Content="Send each game's artwork"
                              IsChecked="{Binding SendArtwork}" />
                    <c:InfoTip Margin="8,0,0,0"
                               AutomationProperties.Name="More about sending artwork"
                               ToolTip="Downloads each game's cover, icon, background and screenshots before the install, and sends them to OPL's ART folder once the game is on the PS2. Files already there are kept. A game without artwork still installs, and the Logs page says so." />
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Height="32" Orientation="Horizontal">
                    <CheckBox VerticalAlignment="Center"
                              Content="Give each game a memory card in OPL"
                              IsChecked="{Binding CreateMemoryCards}" />
                    <ComboBox Margin="12,0,0,0"
                              Width="80"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="Memory card size"
                              ItemsSource="{Binding MemoryCardSizes}"
                              ItemStringFormat="{}{0} MB"
                              SelectedItem="{Binding MemoryCardSize}"
                              IsEnabled="{Binding CreateMemoryCards}" />
                    <c:InfoTip Margin="8,0,0,0"
                               AutomationProperties.Name="More about memory cards"
                               ToolTip="Each game installed gets a virtual memory card in OPL's VMC folder, named as OPL names it, and set in slot 1 of its OPL settings. 8 MB is the size of Sony's cards and holds any game's saves; larger cards only help games that share one, and some games accept only 8 MB. A card that is already on the PS2 is kept with its saves unless you choose to replace it." />
                </StackPanel>
                <c:StatusPanel DockPanel.Dock="Top" Margin="0,12,0,0" Status="{Binding Status}" />
                <Grid Margin="0,12,0,0">
                    <ListView AutomationProperties.Name="Install queue"
                              c:TableColumns.Key="queue"
                              c:TableColumns.Fill="detail"
                              ItemsSource="{Binding Items}"
                              SelectionMode="Extended"
                              SelectionChanged="QueueList_OnSelectionChanged"
                              Loaded="GameList_Loaded"
                              Visibility="{Binding IsEmpty, Converter={StaticResource CollapsedWhenTrue}}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Source file"
                                                local:GameColumnSort.SortPath="SourceFile"
                                                c:TableColumns.Id="source"
                                                c:TableColumns.MinWidth="140"
                                                c:TableColumns.MaxAutoWidth="360"
                                                c:TableColumns.MeasurePath="SourceFile">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Text.Cell}" TextTrimming="CharacterEllipsis" Text="{Binding SourceFile, Mode=OneWay}" ToolTip="{Binding SourceFile, Mode=OneWay}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Disc ID"
                                                DisplayMemberBinding="{Binding DiscId}"
                                                c:TableColumns.Id="discId"
                                                c:TableColumns.MinWidth="72"
                                                c:TableColumns.MaxAutoWidth="140" />
                                <GridViewColumn Header="Detected title"
                                                DisplayMemberBinding="{Binding DetectedTitle}"
                                                c:TableColumns.Id="title"
                                                c:TableColumns.MinWidth="120"
                                                c:TableColumns.MaxAutoWidth="400" />
                                <GridViewColumn Header="Media"
                                                DisplayMemberBinding="{Binding MediaLabel}"
                                                c:TableColumns.Id="media"
                                                c:TableColumns.MinWidth="64"
                                                c:TableColumns.MaxAutoWidth="140" />
                                <GridViewColumn Header="Size"
                                                local:GameColumnSort.SortPath="InstallBytes"
                                                c:TableColumns.Id="size"
                                                c:TableColumns.MinWidth="72"
                                                c:TableColumns.MaxAutoWidth="110"
                                                c:TableColumns.MeasurePath="SizeLabel">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.Cell}" Text="{Binding SizeLabel, Mode=OneWay}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Status"
                                                local:GameColumnSort.SortPath="StatusLabel"
                                                c:TableColumns.Id="status"
                                                c:TableColumns.MinWidth="96"
                                                c:TableColumns.MaxAutoWidth="220"
                                                c:TableColumns.MeasurePath="StatusLabel"
                                                c:TableColumns.Chip="True">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Chip" Style="{StaticResource Chip}" AutomationProperties.Name="{Binding StatusLabel, Mode=OneWay}">
                                                <TextBlock x:Name="ChipText"
                                                           Style="{StaticResource Text.Label}"
                                                           Text="{Binding StatusLabel, Mode=OneWay, Converter={StaticResource UpperCase}}" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Ready">
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AppOk}" />
                                                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AppOk}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Installed">
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AppOk}" />
                                                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AppOk}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Installing">
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AppInfo}" />
                                                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AppInfo}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="NeedsConversion">
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AppInfo}" />
                                                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AppInfo}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="NeedsMetadataReview">
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AppWarn}" />
                                                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AppWarn}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Duplicate">
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AppWarn}" />
                                                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AppWarn}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AppErrorFill}" />
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AppError}" />
                                                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AppError}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Detail"
                                                local:GameColumnSort.SortPath="FriendlyDetail"
                                                c:TableColumns.Id="detail"
                                                c:TableColumns.MinWidth="160"
                                                c:TableColumns.MaxAutoWidth="600"
                                                c:TableColumns.MeasurePath="FriendlyDetail">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Text.Cell}" TextTrimming="CharacterEllipsis" Text="{Binding FriendlyDetail, Mode=OneWay}" ToolTip="{Binding FriendlyDetail, Mode=OneWay}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Installation"
                                                DisplayMemberBinding="{Binding InstallationLabel}"
                                                c:TableColumns.Id="installation"
                                                c:TableColumns.MinWidth="80"
                                                c:TableColumns.MaxAutoWidth="130" />
                                <GridViewColumn Header="Duplicate"
                                                DisplayMemberBinding="{Binding DuplicateLabel}"
                                                c:TableColumns.Id="duplicate"
                                                c:TableColumns.MinWidth="72"
                                                c:TableColumns.MaxAutoWidth="120" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <c:ChamferBorder Style="{StaticResource EmptyState}" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                            <TextBlock Style="{StaticResource EmptyHeadline}" Text="Add games to install" />
                            <TextBlock Style="{StaticResource EmptyDetail}" Text="iso, bin, cue and chd files, or whole folders." />
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryButton}" Content="Add files…" Command="{Binding AddFilesCommand}" />
                                <Button Margin="8,0,0,0" Content="Add folder…" Command="{Binding AddFolderCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </c:ChamferBorder>
                </Grid>
            </DockPanel>
        </DataTemplate>
        <!-- Back up discs: a PS2 disc in a PC drive copied to an image, checked against Redump. The disc map shows how each
             stretch was read: as a disc picture with thin rings, and as one bar from the centre to the edge. -->
        <DataTemplate DataType="{x:Type local:BackupViewModel}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="BACK UP DISCS" AutomationProperties.Name="Back up discs" />
                    <TextBlock Style="{StaticResource PageSummary}" Text="{Binding Summary}" />
                </Grid>
                <DockPanel DockPanel.Dock="Top" Style="{StaticResource CommandBar}">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButton}"
                            Content="{Binding BackUpLabel}"
                            ToolTip="Copies the PS2 disc in the drive to an image in the backup folder, and checks it against Redump. A copy can be stopped and resumed."
                            IsEnabled="{Binding CanBackUp}"
                            Command="{Binding BackUpCommand}"
                            Visibility="{Binding CanBackUpAgain, Converter={StaticResource CollapsedWhenTrue}}" />
                    <Button DockPanel.Dock="Right"
                            Content="Back up _again"
                            ToolTip="Makes a second copy of a disc that is backed up already. Two equal copies tell another printing from a read error."
                            Command="{Binding BackUpAgainCommand}"
                            Visibility="{Binding CanBackUpAgain, Converter={StaticResource VisibleWhenTrue}}" />
                    <Button DockPanel.Dock="Right"
                            Margin="0,0,8,0"
                            Content="_Stop"
                            ToolTip="Stops the copy and keeps what it has. Resume this disc goes on from there, after cleaning the disc or in another drive too."
                            Command="{Binding StopCommand}"
                            Visibility="{Binding IsWorking, Converter={StaticResource VisibleWhenTrue}}" />
                    <ComboBox Width="360"
                              Margin="0,0,16,0"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="Disc to back up"
                              ItemsSource="{Binding Discs}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedDisc}"
                              IsEnabled="{Binding CanChooseDisc}"
                              Visibility="{Binding HasSeveralDiscs, Converter={StaticResource VisibleWhenTrue}}" />
                    <CheckBox VerticalAlignment="Center" Content="_Keep going" IsChecked="{Binding KeepGoing}" />
                    <c:InfoTip Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="More about keep going"
                               ToolTip="For a collection: when a disc is backed up, Loadout opens the drive, and the next PS2 disc you put in is backed up by itself. A disc that is backed up already is left alone." />
                </DockPanel>
                <c:StatusPanel DockPanel.Dock="Top" Margin="0,12,0,0" Status="{Binding Status}" />
                <Border DockPanel.Dock="Top"
                        Margin="0,12,0,0"
                        Padding="16"
                        Background="{DynamicResource AppSurface}"
                        BorderBrush="{DynamicResource AppBorder}"
                        BorderThickness="1"
                        Visibility="{Binding HasMap, Converter={StaticResource VisibleWhenTrue}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:DiscPicture Width="200"
                                       Height="200"
                                       AutomationProperties.Name="Disc map as a disc"
                                       View="{Binding Map}"
                                       Describe="{Binding Describe}"
                                       NotReadBrush="{DynamicResource AppTrack}"
                                       Foreground="{DynamicResource AppBorder}"
                                       MarkerBrush="{DynamicResource AppAccent}"
                                       DiscBrush="{DynamicResource AppSurfaceRaised}"
                                       HoleBrush="{DynamicResource AppSurface}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Label}" Foreground="{DynamicResource AppLabel}" Text="EDGE" />
                                <TextBlock Style="{StaticResource Text.Label}" Foreground="{DynamicResource AppLabel}" Text="CENTRE" />
                            </DockPanel>
                            <c:DiscMapBar Margin="0,2,0,0"
                                          AutomationProperties.Name="Disc map from the centre to the edge"
                                          View="{Binding Map}"
                                          Describe="{Binding Describe}"
                                          NotReadBrush="{DynamicResource AppTrack}"
                                          Foreground="{DynamicResource AppMuted}"
                                          MarkerBrush="{DynamicResource AppAccent}" />
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource Text.Body}"
                                       Foreground="{DynamicResource AppText}"
                                       Text="{Binding StatusLine}"
                                       TextTrimming="CharacterEllipsis" />
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Legend}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4,16,0" Orientation="Horizontal">
                                            <Rectangle Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding Brush}" />
                                            <TextBlock Margin="6,0,0,0" Style="{StaticResource Text.Detail}" Foreground="{DynamicResource AppMuted}">
                                                <Run Text="{Binding Label, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Amount, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>
                <DockPanel DockPanel.Dock="Top" Style="{StaticResource CommandBar}">
                    <Button Content="Open _folder"
                            ToolTip="Opens the backup folder in Explorer, with the selected copy picked."
                            Command="{Binding OpenFolderCommand}" />
                    <Button Margin="8,0,0,0"
                            Content="Show _report"
                            ToolTip="Opens the selected copy's report: every pass, failed read and rest of its backup."
                            Command="{Binding ShowReportCommand}" />
                </DockPanel>
                <Grid Margin="0,12,0,0">
                    <ListView AutomationProperties.Name="Backed-up discs"
                              c:TableColumns.Key="backups"
                              c:TableColumns.Fill="name"
                              ItemsSource="{Binding Backups}"
                              SelectedItem="{Binding SelectedBackup}"
                              SelectionMode="Single"
                              Loaded="GameList_Loaded"
                              Visibility="{Binding HasBackups, Converter={StaticResource VisibleWhenTrue}}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name"
                                                c:TableColumns.Id="name"
                                                c:TableColumns.MinWidth="200"
                                                c:TableColumns.MaxAutoWidth="560"
                                                c:TableColumns.MeasurePath="Name">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Text.Cell}" TextTrimming="CharacterEllipsis" Text="{Binding Name, Mode=OneWay}" ToolTip="{Binding Name, Mode=OneWay}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Size"
                                                c:TableColumns.Id="size"
                                                c:TableColumns.MinWidth="72"
                                                c:TableColumns.MaxAutoWidth="110"
                                                c:TableColumns.MeasurePath="SizeLabel">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.Cell}" Text="{Binding SizeLabel, Mode=OneWay}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Date"
                                                DisplayMemberBinding="{Binding DateLabel}"
                                                c:TableColumns.Id="date"
                                                c:TableColumns.MinWidth="88"
                                                c:TableColumns.MaxAutoWidth="130" />
                                <GridViewColumn Header="Result"
                                                c:TableColumns.Id="result"
                                                c:TableColumns.MinWidth="150"
                                                c:TableColumns.MaxAutoWidth="220"
                                                c:TableColumns.MeasurePath="ResultLabel"
                                                c:TableColumns.Chip="True">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Chip" Style="{StaticResource Chip}" AutomationProperties.Name="{Binding ResultLabel, Mode=OneWay}">
                                                <TextBlock x:Name="ChipText"
                                                           Style="{StaticResource Text.Label}"
                                                           Text="{Binding ResultLabel, Mode=OneWay, Converter={StaticResource UpperCase}}" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Result}" Value="MatchesRedump">
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AppOk}" />
                                                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AppOk}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result}" Value="DoesNotMatchRedump">
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AppWarn}" />
                                                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AppWarn}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result}" Value="NotCheckedYet">
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AppWarn}" />
                                                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AppWarn}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Result}" Value="Incomplete">
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AppInfo}" />
                                                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AppInfo}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="On PS2"
                                                DisplayMemberBinding="{Binding OnPs2Label}"
                                                c:TableColumns.Id="onPs2"
                                                c:TableColumns.MinWidth="64"
                                                c:TableColumns.MaxAutoWidth="100" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <c:ChamferBorder Style="{StaticResource EmptyState}" Visibility="{Binding HasBackups, Converter={StaticResource CollapsedWhenTrue}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                            <TextBlock Style="{StaticResource EmptyHeadline}" Text="No discs backed up yet" />
                            <TextBlock Style="{StaticResource EmptyDetail}" Text="Put a PS2 disc in a drive on this PC, then Back up this disc. The copies are kept on the PC, checked against Redump." />
                        </StackPanel>
                    </c:ChamferBorder>
                </Grid>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:ArtworkViewModel}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="ARTWORK" AutomationProperties.Name="Artwork" />
                    <TextBlock Style="{StaticResource PageSummary}" Text="{Binding Summary}" />
                </Grid>
                <DockPanel DockPanel.Dock="Top" Style="{StaticResource CommandBar}">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButton}"
                            Content="_Send to PS2"
                            ToolTip="Writes the cached artwork the PS2 doesn't have yet into OPL's ART folder, through Loadout Bay at the address in Settings. Download artwork first fetches it."
                            IsEnabled="{Binding IsIdle}"
                            Command="{Binding SendCommand}" />
                    <Button DockPanel.Dock="Right"
                            Margin="0,0,8,0"
                            Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhenTrue}}" />
                    <Button Content="_Download artwork"
                            ToolTip="Fetches the covers, icons, backgrounds and screenshots of the installed games into the cache."
                            IsEnabled="{Binding IsIdle}"
                            Command="{Binding DownloadCommand}" />
                    <CheckBox Margin="16,0,0,0"
                              VerticalAlignment="Center"
                              Content="Replace artwork already on the PS2"
                              IsEnabled="{Binding IsIdle}"
                              IsChecked="{Binding ReplaceExisting}" />
                    <c:InfoTip Margin="8,0,0,0"
                               AutomationProperties.Name="More about replacing artwork"
                               ToolTip="A file the PS2 already has is replaced only when this is ticked. Each new file is whole on the PS2 before the old one goes." />
                </DockPanel>
                <c:StatusPanel DockPanel.Dock="Top" Margin="0,12,0,0" Status="{Binding Status}" />
                <Grid Margin="0,12,0,0">
                    <ListView AutomationProperties.Name="Games and their artwork"
                              c:TableColumns.Key="artwork"
                              c:TableColumns.Fill="title"
                              ItemsSource="{Binding Games}"
                              Loaded="GameList_Loaded"
                              Visibility="{Binding HasGames, Converter={StaticResource VisibleWhenTrue}}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Art" Width="56" c:TableColumns.Id="art" c:TableColumns.Fixed="True">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image AutomationProperties.Name="{Binding Title, StringFormat='Cover of {0}'}"
                                                   Width="36"
                                                   Height="48"
                                                   Margin="0,4,0,3"
                                                   HorizontalAlignment="Left"
                                                   Stretch="Uniform"
                                                   Source="{Binding ArtPath, Converter={StaticResource ArtworkPreviewConverter}, TargetNullValue={x:Null}}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Disc ID"
                                                DisplayMemberBinding="{Binding DiscId}"
                                                c:TableColumns.Id="discId"
                                                c:TableColumns.MinWidth="72"
                                                c:TableColumns.MaxAutoWidth="140" />
                                <GridViewColumn Header="Title"
                                                DisplayMemberBinding="{Binding Title}"
                                                c:TableColumns.Id="title"
                                                c:TableColumns.MinWidth="160"
                                                c:TableColumns.MaxAutoWidth="560" />
                                <GridViewColumn Header="In the cache"
                                                DisplayMemberBinding="{Binding Cached}"
                                                c:TableColumns.Id="cache"
                                                c:TableColumns.MinWidth="100"
                                                c:TableColumns.MaxAutoWidth="260" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <c:ChamferBorder Style="{StaticResource EmptyState}" Visibility="{Binding HasGames, Converter={StaticResource CollapsedWhenTrue}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                            <TextBlock Style="{StaticResource EmptyHeadline}" Text="No installed games yet" />
                            <TextBlock Style="{StaticResource EmptyDetail}" Text="Artwork is fetched for the games on the PS2. Connect on Installed Games to read their list." />
                            <Button HorizontalAlignment="Center"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Go to Installed Games"
                                    Command="{Binding DataContext.ShowInstalledCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </c:ChamferBorder>
                </Grid>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:SettingsViewModel}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="SETTINGS" AutomationProperties.Name="Settings" />
                </Grid>
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <!-- At most 760 wide, at the left. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="760" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,16">
                            <ContentControl Content="{Binding Ps2}" ContentTemplate="{StaticResource SettingsHeading}" Focusable="False" />
                            <Grid Style="{StaticResource SettingsRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Esc anywhere in the row cancels a search. -->
                                <Grid.InputBindings>
                                    <KeyBinding Key="Escape" Command="{Binding CancelFindCommand}" />
                                </Grid.InputBindings>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Address" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <c:AddressEditor x:Name="AddressBox" Address="{Binding Host}" EditedCommand="{Binding AddressEditedCommand}" />
                                    <Button x:Name="FindBayButton"
                                            Margin="8,0,0,0"
                                            IsEnabledChanged="FindBay_OnIsEnabledChanged"
                                            IsEnabled="{Binding CanFind}"
                                            Command="{Binding FindBayCommand}"
                                            AutomationProperties.Name="Find Bay"
                                            AutomationProperties.ItemStatus="{Binding FindStatus}"
                                            ToolTip="Looks for Loadout Bay on this PC's networks and fills in its address.">
                                        <StackPanel Orientation="Horizontal">
                                            <Control Width="16"
                                                     Height="16"
                                                     Margin="0,0,8,0"
                                                     Style="{StaticResource Spinner}"
                                                     Visibility="{Binding IsFinding, Converter={StaticResource VisibleWhenTrue}}" />
                                            <AccessText VerticalAlignment="Center" Text="{Binding FindLabel}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="FindCancel"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource LinkButton}"
                                            IsVisibleChanged="FindCancel_OnIsVisibleChanged"
                                            Content="Cancel"
                                            ToolTip="Stops the search. Esc does too."
                                            Command="{Binding CancelFindCommand}"
                                            Visibility="{Binding IsFinding, Converter={StaticResource VisibleWhenTrue}}" />
                                    <!-- Several found: a picker under Find Bay. -->
                                    <Popup IsOpen="{Binding IsChoosing, Mode=TwoWay}"
                                           StaysOpen="False"
                                           PlacementTarget="{Binding ElementName=FindBayButton}"
                                           Placement="Bottom"
                                           VerticalOffset="4"
                                           PopupAnimation="None"
                                           Opened="BayPicker_OnOpened"
                                           Closed="BayPicker_OnClosed">
                                        <Border Width="320"
                                                Background="{DynamicResource AppSurfaceRaised}"
                                                BorderBrush="{DynamicResource AppBorder}"
                                                BorderThickness="1">
                                            <ListBox MaxHeight="218"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     ItemsSource="{Binding FoundBays}"
                                                     ItemContainerStyle="{StaticResource BayPickerItem}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     AutomationProperties.Name="Found Loadout Bays"
                                                     PreviewKeyDown="BayPicker_OnPreviewKeyDown"
                                                     PreviewMouseLeftButtonUp="BayPicker_OnPreviewMouseLeftButtonUp">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <DockPanel>
                                                            <Border DockPanel.Dock="Right"
                                                                    Style="{StaticResource Chip}"
                                                                    Visibility="{Binding IsCurrent, Converter={StaticResource VisibleWhenTrue}}">
                                                                <TextBlock Style="{StaticResource Text.Label}" Text="CURRENT" />
                                                            </Border>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <!-- Wide enough for 255.255.255.255, so the versions line up. -->
                                                                <TextBlock MinWidth="100" Style="{StaticResource Text.Cell}" Text="{Binding Address, Mode=OneWay}" />
                                                                <TextBlock Margin="12,0,0,0"
                                                                           Style="{StaticResource Text.Cell}"
                                                                           Foreground="{DynamicResource AppMuted}"
                                                                           Text="{Binding Label, Mode=OneWay}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </Grid>
                            <!-- The note: help or progress (AppMuted), a Bay found (AppOk), or what to check. -->
                            <StackPanel Margin="180,-4,0,8">
                                <TextBlock Margin="0"
                                           Style="{StaticResource SettingsNote}"
                                           Text="{Binding AddressNote}"
                                           Visibility="{Binding NoteIsPlain, Converter={StaticResource VisibleWhenTrue}}" />
                                <StackPanel Orientation="Horizontal" Visibility="{Binding NoteIsFound, Converter={StaticResource VisibleWhenTrue}}">
                                    <Path Width="16"
                                          Height="16"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"
                                          Data="M3,8.5 L6.5,12 L13,4.5"
                                          Stroke="{DynamicResource AppOk}"
                                          StrokeThickness="2" />
                                    <TextBlock Margin="0"
                                               Style="{StaticResource SettingsNote}"
                                               Foreground="{DynamicResource AppOk}"
                                               Text="{Binding AddressNote}" />
                                </StackPanel>
                                <Grid Visibility="{Binding NoteOffersSearch, Converter={StaticResource VisibleWhenTrue}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Width="16"
                                          Height="16"
                                          Margin="0,1,8,0"
                                          VerticalAlignment="Top"
                                          Stretch="Uniform"
                                          Data="{StaticResource IconWarn}"
                                          Fill="{DynamicResource AppWarn}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Margin="0" Style="{StaticResource SettingsNote}" Foreground="{DynamicResource AppText}" Text="{Binding AddressNote}" />
                                        <StackPanel Visibility="{Binding NoteIsNoneFound, Converter={StaticResource VisibleWhenTrue}}">
                                            <TextBlock Margin="0" Style="{StaticResource SettingsNote}" Foreground="{DynamicResource AppText}"
                                                       Text="•  Loadout Bay is running on the PS2 (its screen says &quot;Ready for the PC&quot;)." />
                                            <TextBlock Margin="0" Style="{StaticResource SettingsNote}" Foreground="{DynamicResource AppText}"
                                                       Text="•  The PS2 and this PC are on the same network." />
                                            <TextBlock Margin="0" Style="{StaticResource SettingsNote}" Foreground="{DynamicResource AppText}"
                                                       Text="•  Windows Firewall lets Loadout through (allow it on private networks if Windows asks)." />
                                            <TextBlock Margin="0,4,0,0"
                                                       Style="{StaticResource SettingsNote}"
                                                       Text="{Binding CutNote}"
                                                       Visibility="{Binding HasCutNote, Converter={StaticResource VisibleWhenTrue}}" />
                                        </StackPanel>
                                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                            <Button Style="{StaticResource LinkButton}"
                                                    Foreground="{DynamicResource AppInfo}"
                                                    Content="Search again"
                                                    Command="{Binding FindBayCommand}"
                                                    IsVisibleChanged="SearchAgain_OnIsVisibleChanged" />
                                            <TextBlock Margin="0"
                                                       Style="{StaticResource SettingsNote}"
                                                       Text=" · or type the address the TV shows."
                                                       Visibility="{Binding NoteIsNoneFound, Converter={StaticResource VisibleWhenTrue}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <ContentControl Content="{Binding InstallSection}" ContentTemplate="{StaticResource SettingsHeading}" Focusable="False" />
                            <Grid Style="{StaticResource SettingsRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Check games" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="Check each game after installing" IsChecked="{Binding CheckInstalls}" />
                                    <c:InfoTip Margin="8,0,0,0"
                                               AutomationProperties.Name="More about checking games"
                                               ToolTip="Loadout Bay reads the whole game back from the PS2's disk and compares every MiB with the image before the game counts as installed. Loadout Bay removes a copy that differs. This adds the time it takes to read the game back." />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource SettingsNote}" Text="Reads the game back from the PS2 and compares it. Slower." />

                            <ContentControl Content="{Binding Backups}" ContentTemplate="{StaticResource SettingsHeading}" Focusable="False" />
                            <Grid Style="{StaticResource SettingsRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Backup folder" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource Text.Body}"
                                           Foreground="{DynamicResource AppText}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding BackupFolderText}"
                                           ToolTip="{Binding BackupFolderText}" />
                                <Button Grid.Column="2"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Content="Change…"
                                        AutomationProperties.Name="Change the backup folder"
                                        Command="{Binding ChangeBackupFolderCommand}" />
                            </Grid>
                            <TextBlock Style="{StaticResource SettingsNote}" Text="Where Back up discs keeps its copies, with their reports and maps." />

                            <ContentControl Content="{Binding Appearance}" ContentTemplate="{StaticResource SettingsHeading}" Focusable="False" />
                            <Grid Style="{StaticResource SettingsRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Theme" />
                                <Border Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <StackPanel Orientation="Horizontal"
                                                KeyboardNavigation.TabNavigation="Once"
                                                PreviewKeyDown="Segments_OnPreviewKeyDown"
                                                AutomationProperties.Name="Theme">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="System"
                                                     IsChecked="{Binding Theme, Converter={StaticResource EnumMatch}, ConverterParameter=System}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="Dark"
                                                     IsChecked="{Binding Theme, Converter={StaticResource EnumMatch}, ConverterParameter=Dark}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="Light"
                                                     IsChecked="{Binding Theme, Converter={StaticResource EnumMatch}, ConverterParameter=Light}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Style="{StaticResource SettingsNote}" Text="{Binding ThemeHelp}" />

                            <ContentControl Content="{Binding Updates}" ContentTemplate="{StaticResource SettingsHeading}" Focusable="False" />
                            <Grid Style="{StaticResource SettingsRow}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="New versions" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Content="Check for updates when Loadout starts" IsChecked="{Binding CheckForUpdates}" />
                                    <c:InfoTip Margin="8,0,0,0"
                                               AutomationProperties.Name="More about checking for updates"
                                               ToolTip="Loadout reads its list of releases from GitHub when it starts. When a newer version is out, it shows what changed and asks; nothing is downloaded until you press Update now. About has Check for updates for any time." />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource SettingsNote}" Text="Asks GitHub, and offers a newer version when one is out." />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:LogsViewModel}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="LOGS" AutomationProperties.Name="Logs" />
                    <TextBlock Style="{StaticResource PageSummary}" Text="{Binding Summary}" />
                </Grid>
                <DockPanel DockPanel.Dock="Top" Style="{StaticResource CommandBar}">
                    <Button Content="Copy _all"
                            ToolTip="Copies every line to the clipboard. Ctrl+C copies the selected lines."
                            Click="CopyAllLogs_OnClick" />
                    <Button Margin="8,0,0,0"
                            Content="Open _error log folder"
                            ToolTip="Opens the folder of errors.log, where unexpected errors are written in full."
                            Click="OpenErrorLogFolder_OnClick" />
                </DockPanel>
                <c:ChamferBorder Margin="0,12,0,0"
                                 Chamfer="6"
                                 Background="{DynamicResource AppSurface}"
                                 BorderBrush="{DynamicResource AppBorder}"
                                 BorderThickness="1"
                                 ClipContent="True">
                    <Grid>
                        <ListBox Style="{StaticResource LogListStyle}"
                                 Background="Transparent"
                                 AutomationProperties.Name="Log"
                                 ItemsSource="{Binding Lines}">
                            <ListBox.CommandBindings>
                                <CommandBinding Command="ApplicationCommands.Copy" Executed="LogList_OnCopy" />
                            </ListBox.CommandBindings>
                        </ListBox>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.Detail}"
                                   Foreground="{DynamicResource AppMuted}"
                                   Text="Nothing yet. Connects, installs and sends are listed here."
                                   Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}" />
                    </Grid>
                </c:ChamferBorder>
            </DockPanel>
        </DataTemplate>
        <!-- About: a section heading as in Settings, without the "Saved" note. -->
        <Style x:Key="AboutHeading" TargetType="Border">
            <Setter Property="DockPanel.Dock" Value="Top" />
            <Setter Property="Margin" Value="0,24,0,8" />
            <Setter Property="Padding" Value="0,0,0,6" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppDivider}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="AboutLine" TargetType="TextBlock" BasedOn="{StaticResource Text.Detail}">
            <Setter Property="Foreground" Value="{DynamicResource AppText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <DataTemplate DataType="{x:Type local:AboutViewModel}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource Text.PageTitle}" Text="ABOUT" AutomationProperties.Name="About" />
                </Grid>
                <!-- At most 760 wide, at the left, as Settings; the licence text takes the rest of the height. -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="760" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,16,0">
                        <StackPanel DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.DialogTitle}"
                                           Foreground="{DynamicResource AppText}"
                                           VerticalAlignment="Center"
                                           Text="{x:Static local:AboutViewModel.Version}" />
                                <Button Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding CheckCommand}"
                                        IsEnabled="{Binding CanCheck}"
                                        AutomationProperties.Name="Check for updates"
                                        ToolTip="Asks GitHub whether a newer Loadout is out.">
                                    <StackPanel Orientation="Horizontal">
                                        <Control Width="16"
                                                 Height="16"
                                                 Margin="0,0,8,0"
                                                 Style="{StaticResource Spinner}"
                                                 Visibility="{Binding IsChecking, Converter={StaticResource VisibleWhenTrue}}" />
                                        <AccessText VerticalAlignment="Center" Text="_Check for updates" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Margin="0,2,0,0"
                                       Style="{StaticResource Text.Body}"
                                       Foreground="{DynamicResource AppMuted}"
                                       Text="{x:Static local:AboutViewModel.Author}" />
                            <!-- The last check's result; the line keeps its height, so nothing below moves. -->
                            <StackPanel Margin="0,10,0,0" MinHeight="18" Orientation="Horizontal">
                                <TextBlock Text="{Binding CheckResult}" VerticalAlignment="Center" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Detail}">
                                            <Setter Property="Foreground" Value="{DynamicResource AppMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasOffer}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppText}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding CheckFailed}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppError}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="UpdateNow_OnClick"
                                        AutomationProperties.Name="Update now"
                                        Visibility="{Binding HasOffer, Converter={StaticResource VisibleWhenTrue}}"
                                        ToolTip="Shows what's new, and updates Loadout when you confirm.">
                                    <AccessText Text="_Update now…" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource AboutHeading}">
                            <TextBlock Style="{StaticResource Text.Label}" Foreground="{DynamicResource AppLabel}" Text="LINKS"
                                       AutomationProperties.Name="Links" AutomationProperties.HeadingLevel="Level2" />
                        </Border>
                        <WrapPanel DockPanel.Dock="Top">
                            <Button Style="{StaticResource LinkButton}" Content="GitHub page"
                                    Tag="{x:Static local:AboutViewModel.RepositoryUrl}" Click="OpenLink_OnClick"
                                    ToolTip="{x:Static local:AboutViewModel.RepositoryUrl}" />
                            <Button Margin="24,0,0,0" Style="{StaticResource LinkButton}" Content="Report a problem"
                                    Tag="{x:Static local:AboutViewModel.IssuesUrl}" Click="OpenLink_OnClick"
                                    ToolTip="{x:Static local:AboutViewModel.IssuesUrl}" />
                            <Button Margin="24,0,0,0" Style="{StaticResource LinkButton}" Content="Changelog"
                                    Tag="{x:Static local:AboutViewModel.ChangelogUrl}" Click="OpenLink_OnClick"
                                    ToolTip="{x:Static local:AboutViewModel.ChangelogUrl}" />
                        </WrapPanel>

                        <Border Style="{StaticResource AboutHeading}">
                            <TextBlock Style="{StaticResource Text.Label}" Foreground="{DynamicResource AppLabel}" Text="DATA"
                                       AutomationProperties.Name="Data" AutomationProperties.HeadingLevel="Level2" />
                        </Border>
                        <StackPanel DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource AboutLine}" Text="Game titles and settings come from " />
                                <Button Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                                        Content="the PS2-OPL-CFG-Database by Thecat1080"
                                        Tag="{x:Static local:AboutViewModel.TitleDatabaseUrl}" Click="OpenLink_OnClick"
                                        ToolTip="{x:Static local:AboutViewModel.TitleDatabaseUrl}" />
                                <TextBlock Style="{StaticResource AboutLine}" Text="." />
                            </StackPanel>
                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource AboutLine}" Text="Artwork comes from " />
                                <Button Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                                        Content="the psx-ps2-opl-art-database by Luden02"
                                        Tag="{x:Static local:AboutViewModel.ArtworkDatabaseUrl}" Click="OpenLink_OnClick"
                                        ToolTip="{x:Static local:AboutViewModel.ArtworkDatabaseUrl}" />
                                <TextBlock Style="{StaticResource AboutLine}" Text=". The images belong to their owners." />
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource AboutHeading}">
                            <TextBlock Style="{StaticResource Text.Label}" Foreground="{DynamicResource AppLabel}" Text="LICENCES"
                                       AutomationProperties.Name="Licences" AutomationProperties.HeadingLevel="Level2" />
                        </Border>
                        <Border DockPanel.Dock="Top"
                                HorizontalAlignment="Left"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal"
                                        KeyboardNavigation.TabNavigation="Once"
                                        PreviewKeyDown="Segments_OnPreviewKeyDown"
                                        AutomationProperties.Name="Licence text">
                                <RadioButton Style="{StaticResource Segment}" GroupName="AboutText" Content="Loadout (MIT)"
                                             IsChecked="{Binding Shown, Converter={StaticResource EnumMatch}, ConverterParameter=Licence}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="AboutText" Content="Third-party notices"
                                             IsChecked="{Binding Shown, Converter={StaticResource EnumMatch}, ConverterParameter=Notices}" />
                            </StackPanel>
                        </Border>
                        <c:ChamferBorder Margin="0,12,0,0"
                                         Chamfer="6"
                                         Background="{DynamicResource AppSurface}"
                                         BorderBrush="{DynamicResource AppBorder}"
                                         BorderThickness="1"
                                         ClipContent="True">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="True" AutomationProperties.Name="Licence text">
                                <TextBlock Margin="12,10,12,12"
                                           Style="{StaticResource Text.Detail}"
                                           Foreground="{DynamicResource AppText}"
                                           TextWrapping="Wrap"
                                           Text="{Binding ShownText}" />
                            </ScrollViewer>
                        </c:ChamferBorder>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- The rail continues the caption, so the two read as one frame around the content. -->
        <Border x:Name="Rail" Background="{DynamicResource AppBand}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,20,0">
                    <Image AutomationProperties.Name="Loadout for PS2" Width="28" Height="28" VerticalAlignment="Center" Source="{StaticResource MarkDrawing}" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Wordmark}"
                                   Foreground="{DynamicResource AppText}"
                                   Text="LOADOUT"
                                   AutomationProperties.Name="Loadout" />
                        <TextBlock Style="{StaticResource Text.Label}"
                                   Foreground="{DynamicResource AppLabel}"
                                   Text="FOR PS2"
                                   AutomationProperties.Name="for PS2" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="24,0,24,24">
                    <TextBlock Style="{StaticResource Text.Label}" Foreground="{DynamicResource AppLabel}" Text="PS2" />
                    <Button Margin="0,4,0,0"
                            Click="AddressLink_OnClick"
                            ToolTip="Change the PS2's address in Settings"
                            AutomationProperties.HelpText="Opens Settings at the PS2's address">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                <Setter Property="Content" Value="{Binding Settings.Host}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Settings.Host, StringFormat='PS2 address {0}'}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Settings.Host}" Value="">
                                        <Setter Property="Content" Value="Not set" />
                                        <Setter Property="AutomationProperties.Name" Value="PS2 address not set" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <ListBox Margin="0,24,0,0"
                         Style="{StaticResource NavListStyle}"
                         AutomationProperties.Name="Pages"
                         ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage}"
                         DisplayMemberPath="Title">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItemStyle}">
                            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>
        <ContentControl x:Name="PageHost"
                        Grid.Column="1"
                        Margin="24,20,24,24"
                        Content="{Binding SelectedPage.Content}"
                        Focusable="False"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
        <!-- The frame's edge against the content: a line in the light theme, nothing in the dark one. -->
        <Rectangle Width="1" HorizontalAlignment="Right" Fill="{DynamicResource AppFrameEdge}" IsHitTestVisible="False" />
        <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Top" Fill="{DynamicResource AppFrameEdge}" IsHitTestVisible="False" />
        <!-- The Bay's header rule at desktop scale: amber at the left, gone by 40% of the width, the same in both themes. -->
        <Rectangle Grid.ColumnSpan="2" Height="2" VerticalAlignment="Top" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#FFF2963A" />
                    <GradientStop Offset="0.4" Color="#00F2963A" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <!-- While a QuestionDialog is open. -->
        <Rectangle Grid.ColumnSpan="2"
                   Fill="{DynamicResource AppScrim}"
                   Visibility="{Binding Path=(local:QuestionDialog.IsOpen), Converter={StaticResource VisibleWhenTrue}}" />
    </Grid>
</local:LoadoutWindow>
