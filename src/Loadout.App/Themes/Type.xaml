<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Families and the type scale. The fallbacks after Barlow draw what it lacks: Greek, Cyrillic, CJK.
         WPF files Barlow Condensed under Barlow as its condensed stretch, so FontCaps is the same family and its styles set FontStretch. -->
    <FontFamily x:Key="FontUi">pack://application:,,,/Assets/Fonts/#Barlow, Segoe UI, Yu Gothic UI</FontFamily>
    <FontFamily x:Key="FontCaps">pack://application:,,,/Assets/Fonts/#Barlow, Segoe UI, Yu Gothic UI</FontFamily>

    <!-- Body: the Window style sets it, so a TextBlock without a style is Text.Body. -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>

    <!-- 20 px and up: Display mode would distort the shapes. CAPS are literals; AutomationProperties.Name carries the sentence. -->
    <Style x:Key="Text.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource FontCaps}" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="LineHeight" Value="32" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
    </Style>
    <Style x:Key="Text.Wordmark" TargetType="TextBlock" BasedOn="{StaticResource Text.PageTitle}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="None" />
    </Style>
    <Style x:Key="Text.DialogTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Text.Headline" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="Text.Detail" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="18" />
    </Style>
    <!-- The row sets the height, so no line height. Tabular digits keep numbers from jittering. -->
    <Style x:Key="Text.Cell" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="NaN" />
        <Setter Property="LineStackingStrategy" Value="MaxHeight" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontFamily" Value="{StaticResource FontCaps}" />
        <Setter Property="FontStretch" Value="Condensed" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="16" />
    </Style>
</ResourceDictionary>
