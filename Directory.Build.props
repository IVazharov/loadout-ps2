<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Keeps this machine's folders out of the binaries. -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Loadout and Loadout Bay share one version, the whole of VERSION (major.minor.patch), which a
         release commit raises by hand. Commits between releases keep it. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>Ivan Vazharov</Authors>
    <Copyright>Copyright (c) 2026 Ivan Vazharov</Copyright>
  </PropertyGroup>

</Project>
